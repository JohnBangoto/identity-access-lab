# Copiez ce fichier en ".env" (ignoré par Git) et renseignez les deux valeurs secrètes.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=labiam
KEYCLOAK_CLIENT_ID=test-app
KEYCLOAK_CLIENT_SECRET=colle-ici-le-secret-du-client
# Générer une valeur : python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=une-longue-chaine-aleatoire
APP_URL=http://localhost:5000

# Chemin du journal des décisions (par défaut : access.log à côté de app.py)
# ACCESS_LOG=C:\splunk-lab\access.log
